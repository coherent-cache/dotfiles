{{- /* Machine identity is derived, not looked up: the short hostname becomes
       the prompt tag, and the git identity is asked for once. Nothing here
       maps a machine name to a role, so this file is the same on every host. */ -}}
{{- $nodeTag := lower .chezmoi.hostname | splitList "." | first -}}
{{- $gitName := promptStringOnce . "gitName" "git user.name" -}}
{{- $gitEmail := promptStringOnce . "gitEmail" "git user.email" -}}
# Generated by .chezmoi.toml.tmpl on `chezmoi init`; edit source, not this file.
[data]
    nodeTag  = {{ $nodeTag | quote }}
    zmxColor = "magenta"
    gitName  = {{ $gitName | quote }}
    gitEmail = {{ $gitEmail | quote }}
