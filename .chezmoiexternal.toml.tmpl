[".local/share/zs"]
    type = "git-repo"
    url = "https://github.com/coherent-cache/zs.git"
    refreshPeriod = "168h"

{{- $zmxVer := "0.7.0" }}
{{- $arch := eq .chezmoi.arch "arm64" | ternary "aarch64" "x86_64" }}
{{- $os := eq .chezmoi.os "darwin" | ternary "macos" "linux" }}
[".local/bin/zmx"]
    type = "archive-file"
    url = "https://github.com/neurosnap/zmx/releases/download/v{{ $zmxVer }}/zmx-{{ $zmxVer }}-{{ $os }}-{{ $arch }}.tar.gz"
    path = "zmx"
    executable = true
    # No refreshPeriod: the URL pins the version, so a periodic re-download only
    # fetches the same file again. chezmoi caches by URL, so bumping $zmxVer still
    # downloads the new release. (Some networks stall TLS to GitHub's release
    # host past chezmoi's 10 s handshake limit, which made every apply fail.)
