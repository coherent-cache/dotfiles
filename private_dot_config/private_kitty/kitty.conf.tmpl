# ~/.config/kitty/kitty.conf — managed by chezmoi (edit the .tmpl in ~/src/dotfiles)
# Reload in a running kitty: ctrl+shift+f5
# Shared tmux-mimicking setup; per-OS font/theme branches below.

# ─── Font ─────────────────────────────────────────────────────────────────────
{{- if eq .chezmoi.os "darwin" }}
# Floating terminal launched via Hyper+Space — larger font for quick access
font_size 16.0
font_family Monaspace Neon
font_features MonaspaceNeon-Regular +calt +liga +ss01 +ss02 +ss03 +ss04 +ss05 +ss06 +ss07 +ss08 +ss09 +ss10
bold_font auto
italic_font auto
bold_italic_font auto
{{- else }}
# Match gnome-terminal: MonaspiceNe Nerd Font (non-Mono variant — heavier glyphs)
# at Regular weight, 12pt. Requires kitty ≥ 0.35 for family="..." style=... syntax.
font_family       family="MonaspiceNe Nerd Font" style=Regular
bold_font         family="MonaspiceNe Nerd Font" style=Bold
italic_font       family="MonaspiceNe Nerd Font" style=Italic
bold_italic_font  family="MonaspiceNe Nerd Font" style="Bold Italic"
font_size         12.0
modify_font       cell_height 110%
# Slight compositing boost — halfway between kitty's Linux default (1.0 0)
# and macOS-style (1.7 30). Tune up/down if text feels too light/heavy.
text_composition_strategy 1.3 15
{{- end }}
disable_ligatures never

# ─── Cursor ───────────────────────────────────────────────────────────────────
cursor_shape           beam
cursor_blink_interval  0.5
cursor_stop_blinking_after 5.0

# ─── Scrollback ───────────────────────────────────────────────────────────────
scrollback_lines       20000
scrollback_pager       less --chop-long-lines --RAW-CONTROL-CHARS +INPUT_LINE_NUMBER

# ─── Mouse / URLs ─────────────────────────────────────────────────────────────
mouse_hide_wait        2.0
url_style              curly
copy_on_select         no
strip_trailing_spaces  smart

# ─── Window ───────────────────────────────────────────────────────────────────
window_padding_width   8
hide_window_decorations no
remember_window_size   yes
confirm_os_window_close 0
{{- if ne .chezmoi.os "darwin" }}
# Native Wayland on kitty 0.46+ draws its own CSD with full buttons.
# Set to x11 if buttons disappear — but that costs scroll performance.
linux_display_server   auto
{{- end }}

# ─── Tabs ─────────────────────────────────────────────────────────────────────
tab_bar_edge           bottom
tab_bar_style          powerline
tab_powerline_style    slanted
# Tab title shows [Z] marker when layout is 'stack' (zoomed), or pane count
# when more than one pane is visible. Uses num_window_groups (not num_windows)
# so overlays like broadcast/hints prompts don't inflate the count.
tab_title_template     "{index}:{title}{' [Z]' if layout_name == 'stack' else (' ('+str(num_window_groups)+')' if num_window_groups > 1 else '')}"
active_tab_font_style   bold
inactive_tab_font_style normal

# ─── Bell ─────────────────────────────────────────────────────────────────────
enable_audio_bell      no
visual_bell_duration   0.0

# ─── Performance ──────────────────────────────────────────────────────────────
repaint_delay          8
input_delay            2
sync_to_monitor        yes

# ─── Remote control (required for `kitten broadcast` and `kitty @`) ───────────
# Enables kittens like broadcast/hints to inject keystrokes or read window state.
# Local-only — any local process can control kitty via the socket.
allow_remote_control   yes
{{- if eq .chezmoi.os "darwin" }}
# Abstract sockets (@) are Linux-only; kitty appends -{pid} to this path.
listen_on              unix:/tmp/mykitty
{{- else }}
listen_on              unix:@kitty
{{- end }}

# ─── Shell / Integration ──────────────────────────────────────────────────────
# Every new tab/OS window opens the zs session picker (bower.sh model:
# sessions are named, purposeful things — see ~/.local/bin/zmx-login).
# Enter goes to a session (focuses its tab if already open), ctrl-n creates
# (typed or cwd name → proj.1), ctrl-c = plain shell. Split panes skip the
# picker: they auto-create the next cwd session via zp. Close tab = detach
# (session survives); `exit` = destroy + close; detach (ctrl+\) = back to
# the picker. Plain login shell when zmx missing.
shell                  {{ .chezmoi.homeDir }}/.local/bin/zmx-login
# no-title: tab titles are owned by the session-name hook in ~/.bash/.zmx
# (tab bar reads 1:proj.1 2:proj.2); kitty's cwd titles would fight it.
shell_integration      enabled no-title

# ─── Clipboard / OSC 52 ───────────────────────────────────────────────────────
clipboard_control      write-clipboard write-primary read-clipboard-ask read-primary-ask

{{- if eq .chezmoi.os "darwin" }}

# ─── macOS behaviour ──────────────────────────────────────────────────────────
# Send Esc+key for Option so alt+arrow pane nav (and M- bindings in remote
# tmux) work. Costs Option-key special characters while typing in kitty.
macos_option_as_alt    yes
# GUI-launched kitty gets the bare system PATH; prepend ~/.local/bin and
# homebrew so zmx / zs / zn / fzf resolve, and the kitty.app bundle dir so
# `kitten` (broadcast, etc.) resolves — it ships only inside the app bundle.
env PATH={{ .chezmoi.homeDir }}/.local/bin:/opt/homebrew/bin:/Applications/kitty.app/Contents/MacOS:${PATH}
# cmd+t: keep cwd like ctrl+a>c (kitty's default new_tab starts in $HOME).
# cmd+n (new OS window) already routes through `shell` → fresh session.
map cmd+t              new_tab_with_cwd
{{- end }}

# ─── Colors: follow the system theme ──────────────────────────────────────────
# kitty (≥ 0.38) auto-detects the OS light/dark preference and live-applies
# light-theme.auto.conf (GitHub Light-ish) or dark-theme.auto.conf
# (Catppuccin Mocha) from this directory. No colors are set here — the
# *-theme.auto.conf files override kitty.conf colors anyway.

# ─── Layouts ──────────────────────────────────────────────────────────────────
# "splits" gives true tmux-style horizontal/vertical splits with neighbor nav.
# "stack" = one window fullscreen (tmux zoom equivalent).
enabled_layouts splits,stack,tall,fat,grid

# ─── Default keybindings (extra to kitty's ctrl+shift+* built-ins) ────────────
# New pane = next cwd-named zmx session (proj.2, ...), no picker.
map ctrl+shift+enter   launch --type=window --cwd=current {{ .chezmoi.homeDir }}/.local/bin/zp
map ctrl+shift+t       new_tab_with_cwd
map ctrl+shift+w       close_window
map ctrl+shift+q       close_tab
map ctrl+shift+equal   change_font_size all +1.0
map ctrl+shift+minus   change_font_size all -1.0
map ctrl+shift+0       change_font_size all 0

# ─── Tmux-style leader bindings (gpakosz/.tmux muscle memory) ─────────────────
# Leader: Ctrl+A (matches tmux's prefix2 = C-a). Press Ctrl+A, release, then
# press the action key.
# Note: kitty intercepts C-a locally. If you SSH somewhere running tmux with
# C-a prefix, that tmux won't see it — comment out this section or use a
# remote-only flag to disable.

# Splits — matches tmux.conf.local: `-` horizontal, `\` vertical
# Each pane auto-creates the next cwd-named zmx session (proj.2, ...) via
# zp — no picker friction inside a project. kitty's shell_integration tracks
# cwd via OSC 7, so `cd somewhere` in the source pane is inherited.
map ctrl+a>minus       launch --location=hsplit --source-window=state:focused --cwd=current {{ .chezmoi.homeDir }}/.local/bin/zp
map ctrl+a>backslash   launch --location=vsplit --source-window=state:focused --cwd=current {{ .chezmoi.homeDir }}/.local/bin/zp

# Picker-splits (spec 003 US2) — shifted variants of the zp splits: `_`
# horizontal, `|` vertical. The new pane runs the zs picker (a fresh
# non-session shell), so you CHOOSE where it lands — another host, a session,
# or a new name. zp = "another pane, same place"; these = "another pane, you
# choose where". Esc closes the pane. CLI twins: zp --host HOST / zp --local.
# --env ZMX_SESSION= : the launched pane inherits kitty's env, which can carry
# a stale ZMX_SESSION (kitty started from inside a session) — without clearing
# it the picker hits the in-session guard and the pane dies instantly.
map ctrl+a>shift+minus     launch --location=hsplit --source-window=state:focused --cwd=current --env ZMX_SESSION= {{ .chezmoi.homeDir }}/.local/bin/zs
map ctrl+a>shift+backslash launch --location=vsplit --source-window=state:focused --cwd=current --env ZMX_SESSION= {{ .chezmoi.homeDir }}/.local/bin/zs

# In-session hop (spec 003 US1): types `zs --hop` at the pane's shell prompt —
# switch this pane to another session on ITS host (works inside plain-SSH
# auto-attached sessions too; the origin session keeps running, detached).
# send_text (not launch): the hop must run INSIDE the session's shell, on the
# session's host. Only meaningful at a shell prompt.
map ctrl+a>h           send_text all zs --hop\r

# Pane navigation — bare Alt+Arrow (no leader), matching tmux.conf.local
# `bind -n M-Left/Right/Up/Down select-pane -L/-R/-U/-D`
map alt+left           neighboring_window left
map alt+right          neighboring_window right
map alt+up             neighboring_window up
map alt+down           neighboring_window down

# Pane resizing (tmux: H/J/K/L by 2 cells). One-shot — no repeat in kitty.
map ctrl+a>shift+h     resize_window narrower 2
map ctrl+a>shift+j     resize_window shorter 2
map ctrl+a>shift+k     resize_window taller 2
map ctrl+a>shift+l     resize_window wider 2

# Move/swap panes (tmux: > < swap with next/prev)
map ctrl+a>shift+period move_window_forward
map ctrl+a>shift+comma  move_window_backward

# Zoom / maximize current pane (tmux default: `prefix z`)
map ctrl+a>z           toggle_layout stack

# Cycle layouts (tmux: `prefix space` next-layout) through enabled_layouts:
# splits → stack → tall → fat → grid. Note stack = everything zoomed.
map ctrl+a>space       next_layout

# Move panes between tabs (tmux: `prefix !` break-pane, join-pane)
# ctrl+a>shift+1 breaks the pane into its own new tab; ctrl+a>m asks which
# tab to move it into; ctrl+a>shift+m moves the whole TAB to another OS window.
map ctrl+a>shift+1     detach_window new-tab
map ctrl+a>m           detach_window ask
map ctrl+a>shift+m     detach_tab ask

# Tabs = tmux windows
# Bare Alt+Shift+Arrow for prev/next tab, matching tmux.conf.local
# `bind -n M-S-Left previous-window` / `M-S-Right next-window`
map alt+shift+left     previous_tab
map alt+shift+right    next_tab
map ctrl+a>c           new_tab_with_cwd
map ctrl+a>comma       set_tab_title
map ctrl+a>ctrl+h      previous_tab
map ctrl+a>ctrl+l      next_tab

# Tabs by number (tmux: prefix+1..9) — matches the {index}: in the tab bar.
map ctrl+a>1           goto_tab 1
map ctrl+a>2           goto_tab 2
map ctrl+a>3           goto_tab 3
map ctrl+a>4           goto_tab 4
map ctrl+a>5           goto_tab 5
map ctrl+a>6           goto_tab 6
map ctrl+a>7           goto_tab 7
map ctrl+a>8           goto_tab 8
map ctrl+a>9           goto_tab 9
# Last tab (tmux: prefix+l); interactive tab chooser (tmux: prefix+w)
map ctrl+a>l           goto_tab 0
map ctrl+a>w           select_tab

# Kill (tmux: x pane with confirm, & window)
# Always confirm pane close. Kitty has no built-in tab-close confirmation.
map ctrl+a>x           close_window_with_confirmation
map ctrl+a>shift+7     close_tab

# Scrollback / copy-mode replacement (tmux: prefix Enter)
# kitten hints highlights visible URLs/paths for click-to-copy.
map ctrl+a>enter       kitten hints

# Broadcast input to all panes in the current tab (≈ tmux `prefix =`
# synchronize-panes). Opens a console as a SPLIT so every pane stays visible;
# keys typed there fan out to all panes in this tab (each lands in that
# pane's zmx session scrollback). Exit with Ctrl+Esc — Ctrl+C/Esc are
# BROADCAST to the panes (Ctrl+C = SIGINT everywhere), that's a feature.
# Ctrl+Alt+Esc toggles hiding the typed input (passwords).
# Must be `kitty +kitten broadcast` (a Python kitten — the standalone
# `kitten` binary doesn't ship it), absolute on macOS: launch resolves the
# command against kitty's own bare GUI PATH, not the child env PATH.
{{- if eq .chezmoi.os "darwin" }}
map ctrl+a>equal       launch --location=hsplit --allow-remote-control /Applications/kitty.app/Contents/MacOS/kitty +kitten broadcast --match-tab=state:focused
{{- else }}
map ctrl+a>equal       launch --location=hsplit --allow-remote-control kitty +kitten broadcast --match-tab=state:focused
{{- end }}

# Reload config (tmux: r)
map ctrl+a>r           load_config_file

# New OS window (≈ tmux session)
map ctrl+a>ctrl+c      new_os_window_with_cwd

# zmx session picker under the leader (tmux: prefix C-f find-session,
# prefix s choose-session). Every tab already opens the picker via `shell`;
# these open one explicitly in a NEW tab (outside the session env) to switch
# without leaving the current session. Detached sessions sort first, newest
# first; Enter goes (focuses the tab if open), alt-enter mirrors here,
# ctrl-n always creates, ctrl-x kills in place.
map ctrl+a>ctrl+f      launch --type=tab --cwd=current {{ .chezmoi.homeDir }}/.local/bin/zs
map ctrl+a>s           launch --type=tab --cwd=current {{ .chezmoi.homeDir }}/.local/bin/zs

# ─── Kitty sessions (tmuxp-style, zmx-backed) ─────────────────────────────────
# save_as_session snapshots the whole arrangement (tabs, splits w/ sizes,
# each pane's foreground `zmx attach <name>`) to a session file; goto_session
# is a picker over the sessions dir. Restoring re-attaches panes to their
# still-alive zmx sessions — actual state resume, not tmuxp-style replay.
# Curated per-project files live in the same dir (managed by chezmoi).
map ctrl+a>shift+s     save_as_session --use-foreground-process --base-dir {{ .chezmoi.homeDir }}/.local/share/kitty/sessions
map ctrl+a>g           goto_session {{ .chezmoi.homeDir }}/.local/share/kitty/sessions
